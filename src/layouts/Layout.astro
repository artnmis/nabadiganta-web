---
const { title } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
import '../styles/global.css';
import ContactOverlay from '../components/ContactOverlay.jsx';
---

<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Noto+Sans+Bengali:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-50 text-slate-900 font-['Hind_Siliguri',_sans-serif]">
    
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-100 py-3 px-4 md:px-10">
      <div class="max-w-[1600px] mx-auto flex items-center justify-between gap-4 relative">
        
        <div class="flex items-center gap-3 md:gap-10 shrink-0">
          <a href="/" class="hover:opacity-90 transition">
            <img src="/logo.png" alt="লোগো" class="h-12 md:h-20 w-auto object-contain" />
          </a>
          
          <div class="flex flex-col justify-center">
            <h1 class="text-lg md:text-3xl font-bold bg-gradient-to-r from-red-600 to-indigo-600 bg-clip-text text-transparent leading-tight font-['Noto_Sans_Bengali',_sans-serif]">
              নবদিগন্ত যুব ফাউন্ডেশন
            </h1>
            <h1 class="text-[10px] md:text-2xl font-bold bg-gradient-to-r from-blue-600 to-red-600 bg-clip-text text-transparent leading-tight font-['Noto_Sans_Bengali',_sans-serif]">
              ভবিষ্যৎ গড়ি একতাবদ্ধ হয়ে
            </h1>
          </div>
        </div>

        <nav class="bg-slate-100/80 p-1.5 rounded-full border border-slate-200 hidden md:block shadow-inner">
          <div class="flex items-center space-x-1 font-semibold text-slate-600 text-sm lg:text-base">
            <a href="/about" class={`px-6 py-2 rounded-full transition-all duration-300 ${pathname === '/about' ? 'bg-blue-600 text-white shadow-md' : 'hover:bg-white hover:text-blue-600'}`}>About Us</a>
            <a href="/initiatives" class={`px-6 py-2 rounded-full transition-all duration-300 ${pathname.startsWith('/initiatives') ? 'bg-blue-600 text-white shadow-md' : 'hover:bg-white hover:text-blue-600'}`}>Initiatives</a>
            <a href="/notices" class={`px-6 py-2 rounded-full transition-all duration-300 ${pathname.startsWith("/notices") ? 'bg-blue-600 text-white shadow-md' : 'hover:bg-white hover:text-blue-600'}`}>Notices</a>
            <button id="contact-trigger" class="px-6 py-2 rounded-full transition-all duration-300 hover:bg-white hover:text-blue-600 cursor-pointer outline-none">Contact Us</button>
          </div>
        </nav>

        <button id="menu-toggle" class="md:hidden p-2 text-slate-600 bg-slate-100 rounded-full focus:outline-none active:scale-95 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>

        <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-white border-b border-slate-100 shadow-xl z-50 md:hidden overflow-hidden">
          <div class="flex flex-col p-4 space-y-2 font-semibold text-slate-600">
            <a href="/about" class={`px-4 py-3 rounded-xl transition-colors ${pathname === '/about' ? 'bg-blue-50 text-blue-600' : 'active:bg-slate-50'}`}>About Us</a>
            <a href="/initiatives" class={`px-4 py-3 rounded-xl transition-colors ${pathname.startsWith('/initiatives') ? 'bg-blue-50 text-blue-600' : 'active:bg-slate-50'}`}>Initiatives</a>
            <a href="/notices" class={`px-4 py-3 rounded-xl transition-colors ${pathname.startsWith('/notices') ? 'bg-blue-50 text-blue-600' : 'active:bg-slate-50'}`}>Notices</a>
            <button id="mobile-contact-trigger" class="text-left px-4 py-3 rounded-xl active:bg-slate-50 text-blue-600">Contact Us</button>
          </div>
        </div>
      </div>
    </header>

    <div class="fixed top-24 right-4 md:right-10 z-[100]">
       <ContactOverlay client:only="react" />
    </div>

    <main class="min-h-screen">
      <slot /> 
    </main>

    <footer class="p-8 bg-slate-800 text-white relative z-10">
      <div class="max-w-[1600px] mx-auto flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8">
        <p class="text-slate-300">© 2026 নবদিগন্ত যুব ফাউন্ডেশন - All rights reserved.</p>
        <a 
          href="https://docs.google.com/forms/d/e/1FAIpQLScsfJ5-b-b2wdH3H_wNB4376XqpPzEGluZWpC_FCJuO7dbyDw/viewform" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2 rounded-full font-bold transition-all shadow-lg active:scale-95 text-sm"
        >
          Become a member
        </a>
      </div>
    </footer>

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const desktopContactBtn = document.getElementById('contact-trigger');
      const mobileContactBtn = document.getElementById('mobile-contact-trigger');

      menuToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu?.classList.toggle('hidden');
      });

      const handleContactClick = (e: MouseEvent) => {
        e.stopPropagation();
        window.dispatchEvent(new CustomEvent('open-contact-modal'));
        mobileMenu?.classList.add('hidden');
      };

      desktopContactBtn?.addEventListener('click', handleContactClick);
      mobileContactBtn?.addEventListener('click', handleContactClick);

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (!menuToggle?.contains(target) && !mobileMenu?.contains(target)) {
          mobileMenu?.classList.add('hidden');
        }
      });
    </script>

  </body>
</html>